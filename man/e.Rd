\name{e}
\alias{e}
\docType{data}
\title{Environment Holding the State of the Estimation Steps}
\description{
The environment where \code{\link{InitStep}} stores the problem definition and
where \code{\link{EstStep}}, \code{\link{CovStep}}, and \code{\link{TabStep}}
keep intermediate and final results.
}
\format{An \code{environment}.}
\details{
A user-written \code{PRED} function (including the code generated by
\code{\link{ctl2nmw}}) reads \code{e$METHOD} -- one of \code{"ZERO"},
\code{"COND"}, or \code{"LAPL"} -- to decide whether second derivatives are
required.  After the estimation steps, results such as the empirical Bayes
estimates or the final parameters can be inspected with, for example,
\code{get("EBE", envir=e)} or \code{e$FinalPara}.
}
\author{Kyun-Seop Bae <k@acr.kr>}
\seealso{\code{\link{InitStep}}, \code{\link{EstStep}}, \code{\link{ctl2nmw}}}
\keyword{datasets}
